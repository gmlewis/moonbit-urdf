name = "gmlewis/urdf"

version = "0.1.0"

import {
  "gmlewis/base64@0.16.14",
  "gmlewis/flate@0.36.18",
  "gmlewis/fonts@0.19.20",
  "gmlewis/gzip@0.34.18",
  "gmlewis/io@0.23.21",
  "moonbitlang/async@0.22.7",
  "moonbitlang/x@0.5.7",
}

readme = "README.md"

repository = "https://github.com/gmlewis/moonbit-urdf"

license = "Apache-2.0"

keywords = [ "cad", "3d", "ros", "urdf" ]

description = "Simple URDF support for MoonBit"

preferred_target = "native"
